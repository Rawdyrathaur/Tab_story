POSTGRES_USER="tabstory"
POSTGRES_PASSWORD="replace-with-a-random-database-password"
POSTGRES_DB="tabstory"
DATABASE_URL="postgresql://tabstory:replace-with-a-random-database-password@localhost:5432/tabstory"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
SYNC_BOOTSTRAP_SECRET="replace-with-private-bootstrap-secret"
# Comma-separated Google OAuth client IDs for the extension and PWA.
GOOGLE_CLIENT_IDS="chrome-client-id.apps.googleusercontent.com,web-client-id.apps.googleusercontent.com"
GOOGLE_WEB_CLIENT_ID="web-client-id.apps.googleusercontent.com"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
TOMBSTONE_RETENTION_DAYS=30
PORT=8787
CLIENT_ORIGINS="http://localhost:5173,chrome-extension://YOUR_EXTENSION_ID"
