# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit sensitive values to git

# Environment Type
NODE_ENV=development

# Extension Configuration
VITE_EXTENSION_ID=
VITE_EXTENSION_NAME=Tab Story
VITE_EXTENSION_VERSION=1.0.1

# API Configuration (if applicable)
VITE_API_BASE_URL=https://api.example.com
VITE_API_TIMEOUT=5000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_SOURCE_MAPS=false

# Logging
VITE_LOG_LEVEL=info

# Security
VITE_CSP_MODE=strict

# OAuth / Authentication (if needed)
VITE_AUTH_CLIENT_ID=
VITE_AUTH_CLIENT_SECRET=
VITE_AUTH_REDIRECT_URI=

# External Services (Chrome Web Store, Analytics, etc.)
VITE_CWS_CLIENT_ID=
VITE_CWS_CLIENT_SECRET=

# Build Configuration
VITE_BUILD_TARGET=es2020
VITE_MINIFY=true

# Storage Configuration
VITE_STORAGE_TYPE=local
VITE_STORAGE_QUOTA_MB=100

# Notification Configuration
VITE_NOTIFICATION_SOUND=enabled
VITE_NOTIFICATION_BADGE=enabled

# Performance
VITE_PERFORMANCE_MONITORING=false
VITE_MEMORY_LIMIT_MB=256

# Feature Toggles
VITE_FEATURE_TIMELINE=true
VITE_FEATURE_AUTO_BACKUP=true
VITE_FEATURE_SMART_CLUSTERING=true
VITE_FEATURE_DARK_MODE=true

# Development only
VITE_DEV_TOOLS_PORT=3000
VITE_DEV_SERVER_HTTPS=false

# Staging Configuration
VITE_STAGING_ENDPOINT=

# Production Configuration
VITE_PROD_ENDPOINT=https://www.google.com/
VITE_PROD_SENTRY_DSN=

# Manifest Configuration
VITE_MANIFEST_V=3
VITE_MANIFEST_TYPE=development

# DO NOT ADD REAL SECRETS TO THIS FILE
# For actual secrets, use:
# 1. .env.local (git-ignored)
# 2. GitHub Secrets for CI/CD
# 3. System environment variables
# 4. Secure secret management tools (Vault, 1Password, etc.)
